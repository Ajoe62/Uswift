# SERVER
NODE_ENV=development
PORT=3000
APP_DOMAIN=https://pay.uswift.app
CORS_ORIGINS=https://pay.uswift.app,chrome-extension://YOUR_EXTENSION_ID

# STRIPE
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/uswift_payments
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uswift_payments
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# REDIS (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# QUEUE SETTINGS
QUEUE_WORKER_CONCURRENCY=5
QUEUE_RATE_LIMIT_MAX=10
QUEUE_RATE_LIMIT_DURATION=60000

# JWT & AUTH
JWT_SECRET=your-jwt-secret-256-bits-minimum
JWT_EXPIRES_IN=7d
EXTENSION_TOKEN_SECRET=your-extension-token-secret

# PAYMENT SETTINGS
PRIMARY_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP
SUCCESS_URL=https://pay.uswift.app/success
CANCEL_URL=https://pay.uswift.app/cancel

# FEATURE FLAGS
FEATURE_SECONDARY_GATEWAY=false
FEATURE_FREE_TRIAL=true
FEATURE_PROMO_CODES=true
FEATURE_STRIPE_TAX=true

# PRODUCTS & PRICES (Stripe Price IDs)
PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxx
PRICE_PRO_ANNUAL=price_xxxxxxxxxxxxx
PRICE_TOKENS_1000=price_xxxxxxxxxxxxx

# OBSERVABILITY
LOG_LEVEL=info
SENTRY_DSN=
METRICS_ENABLED=true

# ADMIN
ADMIN_API_KEY=your-admin-api-key-here
