# Public frontend vars (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_APP_URL=https://uswift-dashboard.vercel.app

# Optional fallback canonical URL
NEXT_PUBLIC_SITE_URL=https://uswift-dashboard.vercel.app

# Server-side vars (only if using dashboard API routes on Vercel)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_API_URL=https://api.mistral.ai
MISTRAL_CHAT_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_FILES_API_URL=https://api.mistral.ai/v1/files
MISTRAL_EMBEDDINGS_API_URL=https://api.mistral.ai/v1/embeddings

# Optional / future payment vars (only if implemented)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
PRICE_PRO_MONTHLY=price_xxxxx
PRICE_PRO_ANNUAL=price_xxxxx
NEXT_PUBLIC_SUCCESS_URL=https://uswift-dashboard.vercel.app/success
NEXT_PUBLIC_CANCEL_URL=https://uswift-dashboard.vercel.app/cancel
FEATURE_FREE_TRIAL=true
FEATURE_PROMO_CODES=true
FEATURE_STRIPE_TAX=true
