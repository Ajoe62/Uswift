{
  "manifest_version": 3,
  "name": "Uswift",
  "version": "1.0.0",
  "description": "Auto-apply to job boards using saved profiles.",
  "action": { "default_popup": "popup.html" },
  "permissions": ["storage", "activeTab", "scripting", "identity", "tabs", "notifications", "alarms"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
