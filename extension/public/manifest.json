{
  "manifest_version": 3,
  "name": "Uswift",
  "version": "1.0.0",
  "description": "Auto-apply to job boards using saved profiles.",
  "action": { "default_popup": "popup.html" },
  "permissions": ["storage", "activeTab", "scripting", "identity", "notifications", "alarms", "tabs"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://pay.uswift.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.lever.co/*",
        "https://boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workday.com/*",
        "https://*.smartrecruiters.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
