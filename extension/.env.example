# ========================================
# USWIFT CHROME EXTENSION - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (already in .gitignore)
# ========================================

# ----------------------------------------
# MISTRAL AI CONFIGURATION
# ----------------------------------------
# Get your API key from: https://console.mistral.ai/
# Used for: AI chat, resume enhancement, cover letter generation, job analysis, interview prep
VITE_MISTRAL_API_KEY=your-mistral-api-key-here
VITE_MISTRAL_BASE_URL=https://api.mistral.ai

# ----------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------
# Get these from your Supabase project settings: https://app.supabase.com/
# Used for: Authentication, job tracker sync, profile storage, application tracking
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ----------------------------------------
# OPTIONAL: BACKEND API CONFIGURATION
# ----------------------------------------
# If you have a custom backend API for job queueing (background worker)
# Leave empty if not using backend API yet
VITE_BACKEND_API_URL=

# ----------------------------------------
# OPTIONAL: ANALYTICS & ERROR TRACKING
# ----------------------------------------
# Sentry DSN for error tracking (if using Sentry)
VITE_SENTRY_DSN=

# Google Analytics / Mixpanel / PostHog tracking ID (if using analytics)
VITE_ANALYTICS_ID=

# ----------------------------------------
# DEVELOPMENT MODE
# ----------------------------------------
# Set to 'development' for local development, 'production' for builds
NODE_ENV=development

# Enable debug logging in development
VITE_DEBUG_MODE=true

# ----------------------------------------
# FEATURE FLAGS (OPTIONAL)
# ----------------------------------------
# Enable/disable features for testing or gradual rollout
VITE_ENABLE_AUTO_APPLY=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_FILE_UPLOADS=true
VITE_ENABLE_CLOUD_SYNC=true

# ----------------------------------------
# RATE LIMITING (OPTIONAL)
# ----------------------------------------
# Maximum AI API calls per minute (to prevent excessive usage)
VITE_AI_RATE_LIMIT=10

# Maximum auto-apply attempts per hour
VITE_AUTO_APPLY_RATE_LIMIT=20
